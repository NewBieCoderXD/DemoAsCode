{
  "name": "demo-as-code-monorepo",
  "private": false,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter demo-as-code build",
    "docs:start": "pnpm --filter @demo-as-code/website start",
    "docs:build": "pnpm --filter @demo-as-code/website build",
    "docs:deploy": "pnpm --filter @demo-as-code/website deploy",
    "lint": "eslint .",
    "format": "oxfmt --ignore-path=apps && pnpm --filter demo-as-code format && pnpm --filter @demo-as-code/website format",
    "napi:create-npm-dirs": "cd apps/engine/post-processor && napi create-npm-dirs",
    "napi:artifacts": "cd apps/engine/post-processor && napi artifacts"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.7.2",
    "@types/jsdom": "28.0.3",
    "@types/node": "26.1.0",
    "eslint": "10.8.0",
    "eslint-plugin-sonarjs": "4.2.0",
    "oxfmt": "0.60.0",
    "tsx": "4.23.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.65.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.9.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.9.0"
}
